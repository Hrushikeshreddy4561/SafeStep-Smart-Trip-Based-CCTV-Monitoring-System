# SafeStep CCTV Web App -- Environment Variables
# Copy this file to .env and fill in your values.
#
# Windows:  copy .env.example .env
# macOS:    cp .env.example .env

SECRET_KEY=change-this-to-a-random-string
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_ALERT_TEMPLATE_ID=
EMAILJS_SUMMARY_TEMPLATE_ID=
APP_URL=http://localhost:5000
POLICE_DEFAULT_PHONE=100

# Supabase Cloud Storage (for evidence images in emails)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_BUCKET=evidence-images
